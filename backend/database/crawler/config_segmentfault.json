{
  "url": "https://segmentfault.com/",
  "fields": {
    "标题": "div > div:nth-of-type(2) > div:nth-of-type(1) > h3 > a",
    "阅读数": "div > div:nth-of-type(1) > div:nth-of-type(3) > span:nth-of-type(1)"
  },
  "container_selector": "ul.list-group.list-group-flush > li",
  "next_button_selector": "div#__next > div:nth-of-type(3) > div:nth-of-type(2) > div:nth-of-type(2) > div > div:nth-of-type(1) > div:nth-of-type(2) > div > ul > div:nth-of-type(1) > li:nth-of-type(7) > a",
  "max_pages": 2,
  "delay": 3,
  "output_filename": "segmentfault.json",
  "detail_fields": {
    "地点": "span.font-size-14.text-secondary",
    "关注": "span.mainLikeNum"
  },
  "detail_container_selector": "div.information.mb-3.font-size-14",
  "detail_url_field": "标题",
  "detail_url_attribute": "href",
  "navigation_mode": "go_back",
  "back_wait_time": 2,
  "detail_page_wait_time": 2,
  "max_detail_retries": 2,
  "continue_on_error": true
}